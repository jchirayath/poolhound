#!/usr/bin/env python3
"""Drive both built pages in a real browser and assert what only a browser knows.

WHY THIS EXISTS

Of the defects found in one week of review, the eight most user-visible were
invisible to every static check and to reading the diff:

  * the public site told every anonymous visitor "signed in — view only";
  * invisible screen-reader spans escaped their container and scrolled the
    whole page 251px sideways at phone width, carrying the tab bar off-screen;
  * the agent-presence check ran once at load, so every control stayed live
    and the "no agent is connected" banner stayed hidden after the Pi dropped;
  * fourteen control buttons were named "On" and "Off" with nothing tying them
    to a device, and twenty charts announced their own axis ticks as their name.

Each was found by asking the browser what it actually had — computed styles,
accessible names, real clicks — and none by analysis. So this is a gate rather
than a habit: "drive it" belongs in done, not in review.

    bin/drive [--port N]          the local build, both pages
    bin/drive --url URL           the DEPLOYED page, read-only

Needs a Playwright browser. Without one it says so and exits 0: a released copy
must build without a browser toolchain, and a missing browser is a fact worth
one line, not a failure. It is NOT silent about being skipped — that is how
bin/selftest and bin/contrast came to have no __main__ and run nothing at all.
"""
import http.server
import json
import os
import re
import socketserver
import sys
import threading

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from poolhound import config, contrast, headers, render      # noqa: E402

FAILS = []

# What the page resolved, as the browser sees it rather than as the stylesheet
# spells it. getPropertyValue on :root follows the cascade, the media query and
# any data-theme stamp, which is the whole point of asking here.
THEME_PROBE = r"""
() => {
  const cs = getComputedStyle(document.documentElement);
  const body = getComputedStyle(document.body);
  const tok = n => (cs.getPropertyValue(n) || '').trim();
  return {
    stamped: document.documentElement.getAttribute('data-theme'),
    dark: matchMedia('(prefers-color-scheme: dark)').matches,
    bodyBg: body.backgroundColor,
    bodyFg: body.color,
    tokens: {pump: tok('--pump'), spa: tok('--spa'), sheer: tok('--sheer'),
             ink: tok('--ink'), panel: tok('--panel')}
  };
}
"""


def _hex(css_colour):
    """'rgb(18, 32, 43)' -> '#12202b', for poolhound.contrast.ratio().

    A browser answers in rgb()/rgba() whatever the stylesheet said, and
    contrast.ratio takes hex. Converting here keeps one WCAG implementation
    in the project instead of a second one written in JavaScript.
    """
    nums = [int(float(n)) for n in re.findall(r"[\d.]+", css_colour or "")[:3]]
    if len(nums) != 3:
        return "#000000"
    return "#%02x%02x%02x" % tuple(max(0, min(255, n)) for n in nums)


def csp_watch(pg):
    """Collect every console line the browser wrote about the policy.

    A Content-Security-Policy that does not match the page it is serving fails
    in exactly one place: "Refused to execute inline script because it violates
    the following Content Security Policy directive", on the console, with the
    page then half-dead and still returning 200. That is the same shape as
    every user-visible defect this file exists for — the server is fine, the
    markup is fine, and the product does not work.

    Read as a list rather than asserted here so the caller can report what the
    browser actually said, which names the directive and the digest it wanted.
    """
    seen = []
    pg.on("console", lambda m: seen.append(m.text)
          if "Content Security Policy" in m.text else None)
    return seen


def check(name, got, want):
    ok = got == want
    if not ok:
        FAILS.append((name, got, want))
    print(f"    {'ok  ' if ok else 'FAIL'}  {name}")
    if not ok:
        print(f"            got  {got!r}\n            want {want!r}")


def serve(site, port, identity):
    """The built pages, plus the one API answer the page reads at load.

    The page asks /api/health for who you are and what you may do, and three of
    the defects above were the page believing the wrong answer. So the answer
    is supplied here rather than mocked inside the browser: the thing under
    test is what the PAGE does with a real response.

    AND IT SENDS THE REAL SECURITY HEADERS. A Content-Security-Policy is an
    HTTP header, so it does not exist on a file:// page and cannot be read out
    of the markup — which means the digest-based policy in poolhound/headers.py
    is a claim no static check can settle. Getting a digest wrong produces a
    page whose own script is refused, and the browser says so in the console
    and nowhere else. So the policy is served here, from the same module the
    server sends it from, and the console is read back below.
    """
    class H(http.server.SimpleHTTPRequestHandler):
        def translate_path(self, path):
            p = path.split("?")[0].split("#")[0]
            if p in ("/", "/index.html"):
                p = "/index.html"
            return os.path.join(site, p.lstrip("/"))

        def end_headers(self):
            p = self.path.split("?")[0].split("#")[0]
            csp = (headers.csp_for_file(self.translate_path(p))
                   if p.endswith(".html") or p.endswith("/")
                   else headers.BASELINE_CSP)
            for name, value in headers.for_response(csp):
                self.send_header(name, value)
            super().end_headers()

        def do_GET(self):
            if self.path.startswith("/api/health"):
                raw = json.dumps(identity).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(raw)))
                self.end_headers()
                self.wfile.write(raw)
                return
            return super().do_GET()

        def log_message(self, *a):
            pass

    # allow_reuse_address, and server_close() below: shutdown() stops the loop
    # and leaves the socket bound, so the second case in the list could not
    # bind and the whole run died after the first page passed. A gate that
    # crashes halfway is a gate that reports on half the product.
    socketserver.ThreadingTCPServer.allow_reuse_address = True
    httpd = socketserver.ThreadingTCPServer(("127.0.0.1", port), H)
    httpd.daemon_threads = True
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    return httpd


STEADY_JUMPS = r"""() => {
  // Each panel is shown for the measurement, because a hidden one has no
  // layout to ask about, and put back exactly as it was afterwards.
  const moved = [];
  for (const nav of document.querySelectorAll('.subnav')) {
    const panel = nav.closest('.panel'), wasHidden = panel && panel.hidden;
    if (panel) panel.hidden = false;
    const links = [...nav.querySelectorAll('a')];
    const saved = links.map(a => a.getAttribute('aria-current'));
    const widths = state => {
      links.forEach(a => a.setAttribute('aria-current', state));
      return links.map(a => a.getBoundingClientRect().width);
    };
    const plain = widths('false'), current = widths('true');
    links.forEach((a, i) => {
      if (Math.abs(current[i] - plain[i]) > 0.5)
        moved.push(a.textContent.trim().slice(0, 32) + ': ' +
                   plain[i].toFixed(1) + ' -> ' + current[i].toFixed(1));
      if (saved[i] === null) a.removeAttribute('aria-current');
      else a.setAttribute('aria-current', saved[i]);
    });
    if (panel) panel.hidden = wasHidden;
  }
  return moved;
}"""


PROBE = r"""
(build) => {
  const nameOf = e => e.getAttribute('aria-label')
    || (e.getAttribute('aria-labelledby') || '').split(' ')
         .map(id => (document.getElementById(id) || {}).textContent || '').join(' ').trim()
    || (e.textContent || '').trim();

  // Horizontal scroll, per tab. The page body must never scroll sideways;
  // a wide table scrolls inside its own box.
  const scroll = {};
  for (const t of [...document.querySelectorAll('[role=tab]')]) {
    const key = t.getAttribute('data-tab');
    t.click();
    window.scrollTo(99999, 0);
    scroll[key] = Math.round(window.scrollX);
    window.scrollTo(0, 0);
  }

  // A CHART'S NAME MUST BE EXPLICIT. nameOf falls back to textContent, and an
  // SVG's text subtree is its axis ticks and its per-point tooltips — which is
  // the ORIGINAL defect: charts announced as "target 2.90.84.17.3Leslie's 21
  // May…". So a chart counts as named only via aria-label or aria-labelledby.
  // Found by stripping aria-labelledby from a chart and watching this pass.
  const svgs = [...document.querySelectorAll('svg[role=img]')];
  const svgNamed = s => !!(s.getAttribute('aria-label')
    || (s.getAttribute('aria-labelledby') || '').split(' ')
         .some(id => (document.getElementById(id) || {}).textContent));
  const ctl  = [...document.querySelectorAll('#tab-control .ctl button, #tab-control input.ctl-val')];

  return {
    scroll,
    unnamedCharts: svgs.filter(s => !svgNamed(s)).length,
    charts: svgs.length,
    unnamedControls: ctl.filter(e => !nameOf(e)).length,
    controls: ctl.length,
    duplicateControlNames: ctl.length - new Set(ctl.map(nameOf)).size,
    liveRegions: document.querySelectorAll('[aria-live],[role=status],[role=alert],output').length,
    tabsTied: [...document.querySelectorAll('[role=tab]')].filter(t => t.getAttribute('aria-controls')).length,
    tabs: document.querySelectorAll('[role=tab]').length,
    apiState: (document.getElementById('api-state') || {}).textContent || '',
  };
}
"""


# EQUIPMENT HEALTH, asked of the browser. The section is private, so its
# absence from the public build is half the assertion; on the private build its
# one control writes, so a `view` reader must find it dimmed by the role
# wiring rather than live and refused, and every reading pill must carry its
# word -- the state is never colour alone.
EQUIP_PROBE = r"""
() => {
  const sec = document.getElementById('home-equipment');
  const btn = document.querySelector('#maint-form button');
  const pills = sec ? [...sec.querySelectorAll('.pill')] : [];
  return {
    present: !!sec,
    form: !!document.getElementById('maint-form'),
    heading: sec ? (sec.querySelector('h2') || {}).textContent || '' : '',
    wordless: pills.filter(p => !(p.textContent || '').trim()).length,
    pills: pills.length,
    button: btn ? (btn.getAttribute('aria-label') || btn.textContent || '').trim() : '',
    disabled: btn ? btn.disabled : null,
  };
}
"""
# ANOMALIES, the same two questions: absent from the public build, and on the
# private one every severity and state is a word, never a tint alone -- and
# the section sits directly above Equipment health, where the brief put it.
ANOM_PROBE = r"""
() => {
  const sec = document.getElementById('home-anomalies');
  const pills = sec ? [...sec.querySelectorAll('.pill')] : [];
  const next = sec ? sec.nextElementSibling : null;
  return {
    present: !!sec,
    heading: sec ? (sec.querySelector('h2') || {}).textContent || '' : '',
    wordless: pills.filter(p => !(p.textContent || '').trim()).length,
    above: next ? next.id : '',
    width: sec ? sec.scrollWidth - sec.clientWidth : 0,
  };
}
"""
STOCK_FORM = r"""() => {
  const f = document.getElementById('stock-form');
  if (!f) return null;
  const kind = f.querySelector('#stock-kind'), chem = f.querySelector('#stock-chem'),
        unit = f.querySelector('#stock-unit'), paid = f.querySelector('#stock-paid-f');
  const pick = (el, v) => { el.value = v; el.dispatchEvent(new Event('change', {bubbles: true})); };
  const units = () => [...unit.options].map(o => o.value);
  const shown = el => !el.hidden && getComputedStyle(el).display !== 'none';
  pick(kind, 'purchase'); pick(chem, 'salt');
  const salt = {units: units(), unit: unit.value, paid: shown(paid)};
  pick(chem, 'acid');
  const acid = {units: units(), unit: unit.value};
  pick(kind, 'stocktake');
  const counted = shown(paid);
  pick(kind, 'purchase');
  return {salt, acid, counted};
}"""


def stock_form(pg):
    """The stock form, by real change events: the units follow the chemical, a
    solid is never offered a volume, and a count has no price box.

    The server refuses a gallon of salt whatever the page offers; this is that
    the page does not offer it, and that the price box a count cannot use is
    not left there to be typed into and silently dropped.
    """
    r = pg.evaluate(STOCK_FORM)
    print("    -- the stock form")
    check("the stock form is on the page", r is not None, True)
    if not r:
        return
    check("salt is offered no volume unit",
          [u for u in r["salt"]["units"] if u in ("gal", "qt", "l", "floz")], [])
    check("and defaults to the pound it is sold by", r["salt"]["unit"], "lb")
    check("acid defaults to the gallon", r["acid"]["unit"], "gal")
    check("a purchase shows the price box", r["salt"]["paid"], True)
    check("a count hides it", r["counted"], False)


def drive_live(url, sync_playwright):
    """Drive the page a real visitor gets, over the network.

    WHY BOTH MODES EXIST. Driving the local build tests the CODE — names,
    wiring, scroll, the status line — because those come from the template and
    not from this pool's data. It does not test what the server is actually serving,
    and the two can differ: a stale render, a proxy rewriting something, a
    deploy that put the public page beside a stale private one. This project
    has already shipped that exact pair once.

    PUBLIC PAGE ONLY, and read-only. /admin.html is gated by Entra and a
    browser here has no session; a GET of it answers 302, which the deploy's
    own probes already assert. Nothing here POSTs to production.
    """
    fails_before = len(FAILS)
    with sync_playwright() as pw:
        browser = pw.chromium.launch()
        pg = browser.new_page(viewport={"width": 390, "height": 800})
        errors = []
        pg.on("pageerror", lambda e: errors.append(str(e)))
        violations = csp_watch(pg)
        pg.goto(url, wait_until="networkidle")
        r = pg.evaluate(PROBE, "live")
        print(f"\n  {url} — what a visitor actually gets")
        sideways = {k: v for k, v in r["scroll"].items() if v}
        check("no tab scrolls the page sideways", sideways, {})
        check("every chart has a name of its own", r["unnamedCharts"], 0)
        check("the page can announce what it did", r["liveRegions"] > 0, True)
        check("every tab is tied to its panel", r["tabsTied"], r["tabs"])
        # The live public page is served to nobody signed in, so the status
        # line must say so. This is the sentence that read "signed in — view
        # only" to every anonymous visitor for two hours.
        check("the status line tells the truth", r["apiState"], "read-only")
        check("and the script raised nothing", errors, [])
        # ON THE DEPLOYED PAGE THIS IS THE INTERESTING ONE. The policy is
        # derived from the bytes being served, so a server running an older
        # image than the page it is serving — the exact pair this project has
        # shipped once — would refuse that page's script and still answer 200.
        check("the served policy refused nothing the page needs", violations, [])
        browser.close()
    return len(FAILS) == fails_before


SCHEDULE_PROBE = r"""() => {
  const nameOf = e => e.getAttribute('aria-label') || (e.textContent || '').trim();
  const rows = [...document.querySelectorAll('#sched-list tr')];
  const cancels = [...document.querySelectorAll('#sched-list [data-sched-cancel]')];
  return {
    rows: rows.map(r => r.textContent.trim()),
    cancelNames: cancels.map(nameOf),
    afterSelects: [...document.querySelectorAll('.ctl-offafter')].map(nameOf),
    hist: [...document.querySelectorAll('#sched-hist tr')].map(r => r.textContent.trim()),
    alive: (document.getElementById('sched-alive') || {}).textContent || '',
  };
}"""


def drive_schedule(sync_playwright, port):
    """Create a schedule and cancel it, through the page, against a REAL server.

    The rest of this file serves the built pages from a stand-in that answers
    /api/health and nothing else, which is right for what it asks. A schedule
    is the opposite case: the whole point is the round trip -- the form posts,
    the server validates and writes schedules.json, the list is re-read from
    /api/schedules -- and a stand-in would be testing itself. So this starts
    bin/serve in a sandbox of its own (a synthetic pool from bin/demo-data, its
    own data, site and vault directories, notifications off) and drives that.
    Nothing it does can reach a real pool: there is no agent, and the schedule
    is for tomorrow and is cancelled before the process exits.
    """
    import shutil, subprocess, tempfile, time, urllib.request
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    box = tempfile.mkdtemp(prefix="poolhound-drive-")
    env = dict(os.environ,
               POOLHOUND_DATA=os.path.join(box, "data"),
               POOLHOUND_SITE=os.path.join(box, "site"),
               POOLHOUND_CONFIG=os.path.join(box, "config.toml"),
               POOLHOUND_VAULT=os.path.join(box, "vault"),
               POOLHOUND_PORT=str(port), POOLHOUND_NO_NOTIFY="1")
    env.pop("POOLHOUND_REQUIRE_DATA", None)
    proc = None
    fails_before = len(FAILS)
    try:
        subprocess.run([sys.executable, os.path.join(here, "bin", "demo-data"), box],
                       env=env, check=True, capture_output=True, timeout=120)
        proc = subprocess.Popen([sys.executable, os.path.join(here, "bin", "serve")],
                                env=env, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
        url = f"http://127.0.0.1:{port}"
        for _ in range(120):
            try:
                urllib.request.urlopen(url + "/api/health", timeout=1).read()
                break
            except Exception:                              # noqa: BLE001
                time.sleep(0.25)
        print("\n  admin.html — a schedule created and cancelled, against bin/serve")
        with sync_playwright() as pw:
            browser = pw.chromium.launch()
            pg = browser.new_page(viewport={"width": 390, "height": 800})
            errors, dialogs = [], []
            pg.on("pageerror", lambda e: errors.append(str(e)))
            violations = csp_watch(pg)

            def on_dialog(d):
                dialogs.append(d.message)
                d.accept()
            pg.on("dialog", on_dialog)
            pg.goto(url + "/admin.html", wait_until="networkidle")
            pg.click('[data-tab="control"]')
            pg.wait_for_function(
                "() => !/Reading/.test(document.getElementById('sched-list').textContent)",
                timeout=10000)
            before = pg.evaluate(SCHEDULE_PROBE)
            check("the list is read from the server, and starts empty",
                  before["rows"], ["Nothing is scheduled."])
            check("the scheduler says it is alive",
                  "The scheduler checks every" in before["alive"], True)
            check("every 'then off after' names its device",
                  len(set(before["afterSelects"])) == len(before["afterSelects"]) > 0,
                  True)
            import datetime as _dt
            tomorrow = (_dt.date.today() + _dt.timedelta(days=1)).isoformat()
            pg.select_option("#sched-what", "set|Aux_1|1")
            pg.select_option("#sched-rep", "once")
            pg.fill("#sched-date", tomorrow)
            pg.fill("#sched-time", "07:30")
            pg.click("#sched-add")
            pg.wait_for_function(
                "() => document.querySelectorAll('#sched-list [data-sched-cancel]').length === 1",
                timeout=10000)
            made = pg.evaluate(SCHEDULE_PROBE)
            check("the new schedule is listed, with a countdown",
                  len(made["rows"]) == 1 and made["rows"][0].startswith("in "), True)
            # NAMED FOR WHAT IT CANCELS, the On/Off defect this file opens
            # with: a column of buttons all called "Cancel" is "press the third
            # one" again.
            names = made["cancelNames"]
            check("its Cancel button says which schedule it ends",
                  len(names) == 1
                  and names[0].startswith("Cancel the schedule: Pool light on, ")
                  and names[0].endswith("07:30"), True)
            pg.click("#sched-list [data-sched-cancel]")
            pg.wait_for_function(
                "() => /Nothing is scheduled/.test(document.getElementById('sched-list').textContent)",
                timeout=10000)
            after = pg.evaluate(SCHEDULE_PROBE)
            check("cancelled, it is gone from the list", after["rows"],
                  ["Nothing is scheduled."])
            check("and the history says who cancelled it",
                  any("cancelled" in h for h in after["hist"]), True)
            check("the cancel asked first", len(dialogs), 1)
            check("and the script raised nothing", errors, [])
            check("the policy refused nothing the page needs", violations, [])
            with open(os.path.join(box, "data", "schedules.json")) as f:
                on_disk = json.load(f)
            check("and the file on disk agrees", on_disk["schedules"], [])
            browser.close()
    except subprocess.CalledProcessError as e:
        check("the sandbox could be built", e.stderr.decode()[-300:], "")
    finally:
        if proc:
            proc.terminate()
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
        shutil.rmtree(box, ignore_errors=True)
    return len(FAILS) == fails_before


def main():
    port = 8788
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    live_url = ""
    if "--url" in sys.argv:
        live_url = sys.argv[sys.argv.index("--url") + 1]
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        print("  bin/drive: no Playwright here, so the browser checks did not run.")
        print("            pip install playwright && playwright install chromium")
        return 0

    # --url drives the DEPLOYED page instead of the local build. Used by
    # bootstrap-server.sh --check, which verifies what is live and changes
    # nothing.
    if live_url:
        print("  poolhound — the deployed page, driven at phone width")
        drive_live(live_url, sync_playwright)
        print()
        if FAILS:
            print(f"  {len(FAILS)} FAILURE(S):")
            for n, got, want in FAILS:
                print(f"    {n}: got {got!r}, wanted {want!r}")
            return 1
        print(f"  {live_url} behaves, in a browser, at 390px")
        return 0

    site = config.site_dir(config.load())
    for name in ("index.html", "admin.html"):
        if not os.path.exists(os.path.join(site, name)):
            print(f"  bin/drive: {name} has not been rendered. Run bin/render first.")
            return 1

    print("  poolhound — driven in a browser, at phone width")
    CASES = [
        ("index.html", "public, nobody signed in",
         {"ok": True, "user": "anonymous", "public": True, "signed_in": False},
         "read-only"),
        ("admin.html", "authenticated, view-only",
         {"ok": True, "user": "someone@example.com", "public": True,
          "signed_in": True, "token": "t", "role": "view"},
         "signed in — view only"),
    ]
    httpd = None
    try:
        with sync_playwright() as pw:
            browser = pw.chromium.launch()
            for page_name, why, identity, want_state in CASES:
                if httpd:
                    httpd.shutdown()
                    httpd.server_close()
                httpd = serve(site, port, identity)
                pg = browser.new_page(viewport={"width": 390, "height": 800})
                errors = []
                pg.on("pageerror", lambda e: errors.append(str(e)))
                violations = csp_watch(pg)
                pg.goto(f"http://127.0.0.1:{port}/{page_name}", wait_until="networkidle")
                r = pg.evaluate(PROBE, page_name)
                print(f"\n  {page_name} — {why}")
                sideways = {k: v for k, v in r["scroll"].items() if v}
                check("no tab scrolls the page sideways", sideways, {})
                check("every chart has a name of its own", r["unnamedCharts"], 0)
                check("every control has a name", r["unnamedControls"], 0)
                check("and no two controls share one", r["duplicateControlNames"], 0)
                check("the page can announce what it did",
                      r["liveRegions"] > 0, True)
                check("every tab is tied to its panel", r["tabsTied"], r["tabs"])
                check("the status line tells the truth", r["apiState"], want_state)
                check("and the script raised nothing", errors, [])
                # THE POLICY MATCHES THE PAGE. The only proof that the digests
                # in headers.py are the ones this browser computes.
                check("the policy refused nothing the page needs", violations, [])
                # MARKING A SECTION CURRENT MUST NOT MOVE ANYTHING. The
                # jump-list wraps, and the current link used to be set bolder
                # and so wider: on a list sitting at its wrap point, marking a
                # section pushed the list onto a second line, the content moved
                # 34px, the observer chose a different section, and the list
                # unwrapped -- about thirty times a second, at every window
                # width from 1140 to 1480, scrolled a little from the top of
                # Poolhound info. Asked of every link at once, so it does not
                # depend on finding the one width where it shows.
                check("marking a section current changes no link's width",
                      pg.evaluate(STEADY_JUMPS), [])
                # WHAT MOVES THIS POOL. Its last column is a sentence, and under
                # the base td nowrap the table laid out 2,810px wide in a 358px
                # card: every reason a figure was not yet measured had to be
                # dragged into view. It must fit its card at phone width, every
                # status must carry its word and not only its colour, and the
                # public build must not carry it at all.
                fit = pg.evaluate("""() => {
                    document.querySelector('[data-tab="home"]')?.click();
                    const t = document.querySelector('[data-fit] table.fit');
                    if (!t) return {present: !!document.querySelector('[data-fit]')};
                    const sc = t.closest('.scroll');
                    return {present: true,
                            overflow: sc.scrollWidth - sc.clientWidth,
                            wordless: [...t.querySelectorAll('.pill')]
                                .filter(p => !p.textContent.trim()).length,
                            rows: t.querySelectorAll('tbody tr').length};
                }""")
                if page_name == "admin.html":
                    check("the fitted coefficients are on Home", fit["present"], True)
                    check("their table fits its card at phone width",
                          fit.get("overflow", 1) <= 1, True)
                    check("and every status says its word", fit.get("wordless"), 0)
                else:
                    check("the public page carries no fitted coefficients",
                          fit["present"], False)
                eq = pg.evaluate(EQUIP_PROBE)
                if page_name == "admin.html":
                    check("Equipment health is on Home", eq["heading"].strip(),
                          "Equipment health")
                    check("and every reading in it carries its word",
                          (eq["pills"] > 0, eq["wordless"]), (True, 0))
                    check("marking a cleaning is a named control",
                          eq["button"], "Mark it done")
                    check("which a view-only reader finds dimmed, not live",
                          eq["disabled"], True)
                else:
                    check("the household's equipment is not in the public build",
                          (eq["present"], eq["form"]), (False, False))
                an = pg.evaluate(ANOM_PROBE)
                if page_name == "admin.html":
                    check("Anomalies is on Home, above Equipment health",
                          (an["heading"].strip(), an["above"]),
                          ("Anomalies", "home-equipment"))
                    check("and every severity in it is a word", an["wordless"], 0)
                    check("and nothing in it is wider than the phone",
                          an["width"] <= 0, True)
                else:
                    check("the household's anomalies are not in the public build",
                          an["present"], False)
                if page_name == "admin.html":
                    stock_form(pg)
                pg.close()

            # AND AGAIN IN THE DARK, which nothing drove until now.
            #
            # bin/contrast reads the palettes out of the stylesheet and checks
            # them as text. It cannot say whether the dark block APPLIES: a
            # token defined only inside the media query, a selector that wins
            # over it, a colour that resolves to nothing and falls back to
            # black — all are invisible to a reader of the CSS and to every
            # screenshot taken in light mode. The un-stamped "follow the
            # system" state is the common one, so that is what is driven here:
            # a fresh context has no localStorage, so nothing has stamped
            # data-theme and the page is deciding for itself.
            for page_name, why, identity, _want in CASES:
                if httpd:
                    httpd.shutdown()
                    httpd.server_close()
                httpd = serve(site, port, identity)
                seen = {}
                for scheme in ("light", "dark"):
                    pg = browser.new_page(viewport={"width": 390, "height": 800},
                                          color_scheme=scheme)
                    pg.goto(f"http://127.0.0.1:{port}/{page_name}",
                            wait_until="networkidle")
                    seen[scheme] = pg.evaluate(THEME_PROBE)
                    seen[scheme]["scroll"] = pg.evaluate(PROBE, page_name)["scroll"]
                    pg.close()

                print(f"\n  {page_name} — in the dark, as the system asks")
                d, lt = seen["dark"], seen["light"]
                check("the browser really was asked for dark", d["dark"], True)
                check("and nothing had stamped a theme on the page",
                      d["stamped"] in (None, "", "auto"), True)

                # THE DARK BLOCK APPLIES AT ALL. A colour whose only
                # definition sits inside the media query does not reach the
                # un-stamped state, and the page then renders light-on-light.
                check("the page is not identical to its light build",
                      d["bodyBg"] != lt["bodyBg"], True)

                # NOTHING FELL BACK TO BLACK. The whole series palette did
                # exactly this for several commits while every screenshot
                # looked plausible.
                for scheme in ("light", "dark"):
                    unresolved = sorted(k for k, v in seen[scheme]["tokens"].items()
                                        if not v)
                    check(f"every colour token resolves ({scheme})",
                          unresolved, [])

                # AND THE TEXT IS READABLE, measured from what the browser
                # computed rather than from the stylesheet. ratio() comes from
                # poolhound.contrast, which bin/contrast uses, so there is one
                # WCAG implementation and not two.
                for scheme in ("light", "dark"):
                    s = seen[scheme]
                    r = contrast.ratio(_hex(s["bodyFg"]), _hex(s["bodyBg"]))
                    check(f"body text on body background is legible ({scheme},"
                          f" {r:.1f}:1)", r >= 4.5, True)

                sideways = {k: v for k, v in d["scroll"].items() if v}
                check("no tab scrolls the page sideways in the dark",
                      sideways, {})

            browser.close()
    finally:
        if httpd:
            httpd.shutdown()
            httpd.server_close()

    # A real server, not the stand-in: the schedule is a round trip or it is
    # nothing. Its own port, so a stand-in still releasing 8788 cannot collide.
    drive_schedule(sync_playwright, port + 1)

    print()
    if FAILS:
        print(f"  {len(FAILS)} FAILURE(S):")
        for n, got, want in FAILS:
            print(f"    {n}: got {got!r}, wanted {want!r}")
        return 1
    print("  the page behaves, in a browser, at 390px")
    return 0


if __name__ == "__main__":
    sys.exit(main())
