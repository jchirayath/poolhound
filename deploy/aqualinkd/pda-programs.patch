diff --git a/extras/test_pda_programs.c b/extras/test_pda_programs.c
new file mode 100644
index 0000000..d41acea
--- /dev/null
+++ b/extras/test_pda_programs.c
@@ -0,0 +1,268 @@
+/*
+ * Feed screens captured off a PDA-PS6 Combo through the real menu tracker and
+ * the real parser. Built against every AqualinkD object except main().
+ *
+ *   make test_pda_programs   (see deploy/aqualinkd/build.sh in poolhound)
+ *
+ * Exits non-zero on the first wrong answer.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#include "aqualink.h"
+#include "pda_menu.h"
+#include "pda_programs.h"
+#include "aq_scheduler.h"
+#include "config.h"
+#include <unistd.h>
+
+// Defined in aqualinkd.c beside main(), which this harness replaces.
+void intHandler(int dummy) { (void)dummy; }
+bool isAqualinkDStopping() { return false; }
+bool checkAqualinkTime() { return true; }
+bool isVirtualButtonEnabled() { return false; }
+
+static int failures = 0;
+#define CHECK(name, cond) do { if (cond) printf("  ok    %s\n", name); \
+  else { printf("  FAIL  %s\n", name); failures++; } } while (0)
+
+static void pkt_clear(void) {
+  unsigned char p[] = {0x10, 0x02, 0x60, CMD_PDA_CLEAR, 0x46, 0x00, 0x00, 0x10, 0x03};
+  process_pda_menu_packet(p, sizeof(p), false);
+}
+static void pkt_line(int line, const char *text) {
+  unsigned char p[32] = {0x10, 0x02, 0x60, CMD_MSG_LONG, (unsigned char)line};
+  memcpy(p + 5, text, 16);
+  p[21] = 0x00; p[22] = 0x10; p[23] = 0x03;
+  process_pda_menu_packet(p, 24, false);
+}
+static void pkt_highlight(int line) {
+  unsigned char p[] = {0x10, 0x02, 0x60, CMD_PDA_HIGHLIGHT, (unsigned char)line, 0x00, 0x00, 0x00, 0x10, 0x03};
+  process_pda_menu_packet(p, sizeof(p), false);
+}
+static void pkt_shift(void) {
+  unsigned char p[] = {0x10, 0x02, 0x60, CMD_PDA_SHIFTLINES, 0x02, 0x09, 0xff, 0x00, 0x10, 0x03};
+  process_pda_menu_packet(p, sizeof(p), false);
+}
+
+static void screen_lines(char out[PDA_LINES][AQ_MSGLEN + 1]) {
+  int i;
+  for (i = 0; i < PDA_LINES; i++) snprintf(out[i], AQ_MSGLEN + 1, "%s", pda_m_line(i));
+}
+
+int main(void)
+{
+  char lines[PDA_LINES][AQ_MSGLEN + 1];
+  panel_program p;
+
+  printf("menu detection, in the order the panel sends the lines\n");
+
+  pkt_clear();
+  pkt_line(0, "   MAIN MENU    "); pkt_line(2, "HELP           >"); pkt_line(3, "PROGRAM        >");
+  pkt_line(4, "SET TEMP       >"); pkt_line(5, "SET TIME       >"); pkt_line(6, "PDA OPTIONS    >");
+  pkt_line(7, "SYSTEM SETUP   >"); pkt_highlight(2);
+  CHECK("the main menu is still PM_MAIN, though it lists PROGRAM", pda_m_type() == PM_MAIN);
+
+  pkt_clear();
+  pkt_line(0, "    PROGRAM     "); pkt_line(2, "FILTER PUMP     "); pkt_line(3, "SPA             ");
+  pkt_line(4, "VSP1 SPD PGM    "); pkt_line(5, "POOL HEAT       "); pkt_line(6, "SPA HEAT        ");
+  pkt_line(7, "SOLAR HEAT      "); pkt_line(8, "POOL LIGHT      "); pkt_line(9, "SHEER DSCNT     ");
+  pkt_highlight(2);
+  CHECK("the device list is PM_PROGRAM", pda_m_type() == PM_PROGRAM);
+  CHECK("with FILTER PUMP highlighted", strncmp(pda_m_hlight(), "FILTER PUMP", 11) == 0);
+
+  pkt_highlight(9); pkt_shift(); pkt_line(9, "SPA LIGHT       ");
+  CHECK("past line 9 the list shifts and the highlight stays on line 9",
+        pda_m_type() == PM_PROGRAM && strncmp(pda_m_hlight(), "SPA LIGHT", 9) == 0);
+
+  // With a program. ADD/DELETE/CHANGE and the highlight arrive BEFORE the title.
+  pkt_clear();
+  pkt_line(7, "ADD      PROGRAM"); pkt_line(8, "DELETE   PROGRAM"); pkt_line(9, "CHANGE   PROGRAM");
+  pkt_highlight(7);
+  CHECK("a device screen is recognised before its title arrives", pda_m_type() == PM_PROGRAM_DEVICE);
+  pkt_line(0, "  FILTER PUMP   "); pkt_line(1, "   PGM 1 of 1   ");
+  pkt_line(3, "ON      10:00 AM"); pkt_line(4, "OFF      4:00 PM"); pkt_line(5, "ALL DAYS        ");
+  CHECK("and after it", pda_m_type() == PM_PROGRAM_DEVICE);
+  screen_lines(lines);
+  CHECK("FILTER PUMP parses", pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, "FILTER PUMP", &p));
+  CHECK("  as PGM 1 of 1", p.pgm == 1 && p.of == 1);
+  CHECK("  on 10:00 AM", strcmp(p.on, "10:00 AM") == 0);
+  CHECK("  off 4:00 PM", strcmp(p.off, "4:00 PM") == 0);
+  CHECK("  ALL DAYS", strcmp(p.days, "ALL DAYS") == 0);
+
+  // POOL HEAT's own title is the string PM_POOL_HEAT matches on line 0.
+  pkt_clear();
+  pkt_line(7, "ADD      PROGRAM"); pkt_line(8, "DELETE   PROGRAM"); pkt_line(9, "CHANGE   PROGRAM");
+  pkt_highlight(7);
+  pkt_line(0, "   POOL HEAT    "); pkt_line(1, "   PGM 2 of 3   ");
+  pkt_line(3, "ON       6:30 AM"); pkt_line(4, "OFF      8:00 AM"); pkt_line(5, "WEEKDAYS        ");
+  CHECK("POOL HEAT's program screen is not the pool heat setpoint screen", pda_m_type() == PM_PROGRAM_DEVICE);
+  screen_lines(lines);
+  CHECK("PGM 2 of 3 parses", pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, "POOL HEAT", &p)
+        && p.pgm == 2 && p.of == 3 && strcmp(p.on, "6:30 AM") == 0 && strcmp(p.days, "WEEKDAYS") == 0);
+
+  // None entered: NO PROGRAMS on 4-5, ADD PROGRAM on 9, then the title.
+  pkt_clear();
+  pkt_line(4, "  NO PROGRAMS   "); pkt_line(5, "    ENTERED     "); pkt_line(9, "  ADD PROGRAM   ");
+  pkt_highlight(9);
+  pkt_line(0, "      SPA       ");
+  CHECK("a device with no programs is PM_PROGRAM_DEVICE", pda_m_type() == PM_PROGRAM_DEVICE);
+  screen_lines(lines);
+  CHECK("and parses as none", pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, "SPA", &p)
+        && p.of == 0 && p.on[0] == '\0' && p.days[0] == '\0' && strcmp(p.device, "SPA") == 0);
+
+  // The real pool-heat setpoint screen must keep its own type.
+  pkt_clear();
+  pkt_line(0, "   POOL HEAT    "); pkt_line(2, "    80`F        ");
+  CHECK("the pool heat setpoint screen is still PM_POOL_HEAT", pda_m_type() == PM_POOL_HEAT);
+
+  // Home must stay home.
+  pkt_clear();
+  pkt_line(4, "POOL MODE    OFF"); pkt_line(8, "MENU            "); pkt_line(9, "EQUIPMENT ON/OFF");
+  pkt_highlight(8); pkt_line(0, "     FRI  4:07PM"); pkt_line(1, "AIR             ");
+  CHECK("home is still PM_HOME", pda_m_type() == PM_HOME);
+
+  printf("parser refuses what it does not recognise\n");
+  memset(lines, 0, sizeof(lines));
+  strcpy(lines[1], "   PGM 1 of 1   ");
+  strcpy(lines[3], "ON      10:00 AM");
+  CHECK("a screen with no OFF time is refused, not guessed",
+        !pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, "X", &p));
+  strcpy(lines[4], "OFF      4:00 PM");
+  strcpy(lines[1], "   PGM 3 of 2   ");
+  CHECK("PGM 3 of 2 is refused",
+        !pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, "X", &p));
+
+  printf("JSON\n");
+  {
+    static struct aqualinkdata d;
+    char buf[4096];
+    _aqconfig_.paneltype_mask = RSP_PDA;
+    d.panel_programs.state = PROGRAMS_OK;
+    d.panel_programs.read_at = 1760050000;
+    d.panel_programs.count = 2;
+    strcpy(d.panel_programs.programs[0].device, "FILTER PUMP");
+    d.panel_programs.programs[0].pgm = 1; d.panel_programs.programs[0].of = 1;
+    strcpy(d.panel_programs.programs[0].on, "10:00 AM");
+    strcpy(d.panel_programs.programs[0].off, "4:00 PM");
+    strcpy(d.panel_programs.programs[0].days, "ALL DAYS");
+    strcpy(d.panel_programs.programs[1].device, "SP\"A\\");
+    build_panel_programs_js(&d, buf, sizeof(buf));
+    printf("  %s\n", buf);
+    CHECK("JSON names the state", strstr(buf, "\"state\":\"ok\"") != NULL);
+    CHECK("JSON carries the program",
+          strstr(buf, "{\"device\":\"FILTER PUMP\",\"pgm\":1,\"of\":1,\"on\":\"10:00 AM\",\"off\":\"4:00 PM\",\"days\":\"ALL DAYS\"}") != NULL);
+    CHECK("JSON escapes quote and backslash", strstr(buf, "\"SP\\\"A\\\\\"") != NULL);
+    _aqconfig_.paneltype_mask = 0;
+    build_panel_programs_js(&d, buf, sizeof(buf));
+    CHECK("a non-PDA panel says unsupported", strstr(buf, "\"state\":\"unsupported\"") != NULL);
+  }
+
+  printf("panel clock\n");
+  {
+    char b[16];
+    CHECK("10:05 AM is 605", pda_parse_clock("10:05 AM") == 605);
+    CHECK("12:00 AM is midnight", pda_parse_clock("12:00 AM") == 0);
+    CHECK("12:30 PM is 750", pda_parse_clock("12:30 PM") == 750);
+    CHECK(" 3:55 PM, as the panel pads it, is 955", pda_parse_clock(" 3:55 PM") == 955);
+    CHECK("13:00 PM is not a panel time", pda_parse_clock("13:00 PM") == -1);
+    CHECK("10:05 with no AM/PM is refused", pda_parse_clock("10:05") == -1);
+    pda_format_clock(955, b, sizeof(b));
+    CHECK("955 is written 3:55 PM", strcmp(b, "3:55 PM") == 0);
+    pda_format_clock(0, b, sizeof(b));
+    CHECK("0 is written 12:00 AM", strcmp(b, "12:00 AM") == 0);
+  }
+
+  printf("a change is refused unless it is one this code has seen work\n");
+  {
+    static struct aqualinkdata d;
+    const char *why;
+    #define REQ(s) pda_programs_request_set(&d, s, (int)strlen(s))
+    _aqconfig_.paneltype_mask = RSP_PDA;
+    why = REQ("SOLAR HEAT/1040-1555");
+    CHECK("before any read: refused", why && strstr(why, "read the programs first"));
+    d.panel_programs.state = PROGRAMS_OK;
+    d.panel_programs.count = 3;
+    strcpy(d.panel_programs.programs[0].device, "SOLAR HEAT");
+    d.panel_programs.programs[0].pgm = 1; d.panel_programs.programs[0].of = 1;
+    strcpy(d.panel_programs.programs[1].device, "SPA");
+    strcpy(d.panel_programs.programs[2].device, "POOL HEAT");
+    d.panel_programs.programs[2].pgm = 1; d.panel_programs.programs[2].of = 2;
+    CHECK("a device not on the list", (why = REQ("HOT TUB/1040-1555")) && strstr(why, "no such device"));
+    CHECK("a device with no program (ADD is unmapped)", (why = REQ("SPA/1040-1555")) && strstr(why, "no program"));
+    CHECK("a device with several programs", (why = REQ("POOL HEAT/1040-1555")) && strstr(why, "several"));
+    CHECK("25:00 is not a time", (why = REQ("SOLAR HEAT/2500-1555")) && strstr(why, "24-hour"));
+    CHECK("10:60 is not a time", (why = REQ("SOLAR HEAT/1060-1555")) && strstr(why, "24-hour"));
+    CHECK("ON equal to OFF", (why = REQ("SOLAR HEAT/1040-1040")) && strstr(why, "same time"));
+    CHECK("no times at all", (why = REQ("SOLAR HEAT")) != NULL);
+    CHECK("a time with a separator in it", (why = REQ("SOLAR HEAT/10:40-1555")) != NULL);
+    d.panel_programs.set.state = PROGRAM_SET_RUNNING;
+    CHECK("a second change while one runs", (why = REQ("SOLAR HEAT/1040-1555")) && strstr(why, "already"));
+    _aqconfig_.paneltype_mask = 0;
+    d.panel_programs.set.state = PROGRAM_SET_NONE;
+    CHECK("a panel that is not a PDA", (why = REQ("SOLAR HEAT/1040-1555")) && strstr(why, "only PDA"));
+    #undef REQ
+  }
+
+  printf("the program routes refuse what a cross-site page could send\n");
+  {
+    // net_services.c keeps its result enum to itself; these are its positions
+    // as this patch leaves them (uActioned, uBad, ... uPrograms is 11).
+    enum { R_ACTIONED = 0, R_BAD = 1, R_PROGRAMS = 11 };
+    int action_URI(request_source from, const char *URI, int uri_length, float value,
+                   bool convertTemp, char **rtnmsg);
+    char *msg = NULL;
+    // A websocket URI is not NUL-terminated. Here it is "programs/set" (12),
+    // and the bytes after it happen to continue "/SOLAR HEAT/...".
+    const char ws[] = "programs/set/SOLAR HEAT/1040-1555";
+    int r;
+    r = action_URI(NET_WS, "programs/refresh", 16, 0, false, &msg);
+    CHECK("refresh over the websocket is refused", r == R_BAD && msg && strstr(msg, "PUT only"));
+    msg = NULL;
+    r = action_URI(NET_API, "programs/refresh", 16, 0, false, &msg);
+    CHECK("refresh as a GET is refused", r == R_BAD && msg && strstr(msg, "PUT only"));
+    msg = NULL;
+    r = action_URI(NET_API, "programs/set/SOLAR HEAT/1040-1555", 33, 0, false, &msg);
+    CHECK("a set as a GET is refused", r == R_BAD && msg && strstr(msg, "PUT only"));
+    msg = NULL;
+    r = action_URI(NET_WS, ws, 12, 0, false, &msg);
+    CHECK("a URI that ends at 'programs/set' is the read, whatever follows it",
+          r == R_PROGRAMS);
+    r = action_URI(NET_API, "programs", 8, 0, false, &msg);
+    CHECK("GET programs is still the read", r == R_PROGRAMS);
+    (void)R_ACTIONED;
+  }
+
+  printf("a schedule save writes only lines in the shape AqualinkD writes\n");
+  {
+    // Every field lands in a line cron runs as root. Each of these must be
+    // refused before the file is opened, so none of them may create it.
+    char out[256];
+    const char *bad[][2] = {
+      {"a url with a shell command in it",
+       "{\"devices\":[{\"enabled\":\"1\",\"min\":\"0\",\"hour\":\"1\",\"daym\":\"*\",\"month\":\"*\",\"dayw\":\"*\",\"url\":\"/api/x;reboot;/set\",\"value\":\"1\"}]}"},
+      {"a field longer than its buffer",
+       "{\"devices\":[{\"enabled\":\"1\",\"min\":\"0000000000000000000000000000000000\",\"hour\":\"1\",\"daym\":\"*\",\"month\":\"*\",\"dayw\":\"*\",\"url\":\"/api/Aux_1/set\",\"value\":\"1\"}]}"},
+      {"a value that is not a number",
+       "{\"devices\":[{\"enabled\":\"1\",\"min\":\"0\",\"hour\":\"1\",\"daym\":\"*\",\"month\":\"*\",\"dayw\":\"*\",\"url\":\"/api/Aux_1/set\",\"value\":\"1 -o /x\"}]}"},
+      {"a cron field with a space in it",
+       "{\"devices\":[{\"enabled\":\"1\",\"min\":\"0 1\",\"hour\":\"1\",\"daym\":\"*\",\"month\":\"*\",\"dayw\":\"*\",\"url\":\"/api/Aux_1/set\",\"value\":\"1\"}]}"},
+      {"an entry with a field missing",
+       "{\"devices\":[{\"enabled\":\"1\",\"min\":\"0\",\"hour\":\"1\",\"daym\":\"*\",\"month\":\"*\",\"url\":\"/api/Aux_1/set\",\"value\":\"1\"}]}"},
+      {"a good entry followed by a bad one",
+       "{\"devices\":[{\"enabled\":\"1\",\"min\":\"0\",\"hour\":\"1\",\"daym\":\"*\",\"month\":\"*\",\"dayw\":\"*\",\"url\":\"/api/Aux_1/set\",\"value\":\"1\"},"
+       "{\"enabled\":\"1\",\"min\":\"0\",\"hour\":\"2\",\"daym\":\"*\",\"month\":\"*\",\"dayw\":\"*\",\"url\":\"/api/Aux_1/set\",\"value\":\"$(id)\"}]}"},
+    };
+    _aqconfig_.enable_scheduler = true;
+    unlink(CRON_FILE);
+    for (size_t k = 0; k < sizeof(bad) / sizeof(bad[0]); k++) {
+      out[0] = '\0';
+      save_schedules_js(bad[k][1], (int)strlen(bad[k][1]), out, sizeof(out));
+      CHECK(bad[k][0], strstr(out, "refused") != NULL && access(CRON_FILE, F_OK) != 0);
+    }
+  }
+
+  printf(failures ? "%d FAILED\n" : "all passed\n", failures);
+  return failures ? 1 : 0;
+}
