diff --git a/source/pda_programs.c b/source/pda_programs.c
new file mode 100644
index 0000000..dbbbe4d
--- /dev/null
+++ b/source/pda_programs.c
@@ -0,0 +1,809 @@
+/*
+ * Read the panel's own equipment programs through the PDA PROGRAM menu.
+ *
+ * The screens, as captured off a PDA-PS6 Combo (PDA 0x60), line by line:
+ *
+ *   PROGRAM device list            one device, with a program   one device, none
+ *   0 "    PROGRAM     "           0 "  FILTER PUMP   "          0 "      SPA       "
+ *   2 "FILTER PUMP     " (hlight)  1 "   PGM 1 of 1   "          4 "  NO PROGRAMS   "
+ *   3 "SPA             "           3 "ON      10:00 AM"          5 "    ENTERED     "
+ *   ...                            4 "OFF      4:00 PM"          9 "  ADD PROGRAM   " (hlight)
+ *   9 "SHEER DSCNT     "           5 "ALL DAYS        "
+ *                                  7 "ADD      PROGRAM" (hlight)
+ *                                  8 "DELETE   PROGRAM"
+ *                                  9 "CHANGE   PROGRAM"
+ *
+ * The device list is a ring: past line 9 the panel shifts the lines up and
+ * redraws line 9 with the highlight left on it, and after the last device it
+ * comes back round to the first. The walk stops when the first name returns.
+ *
+ * A device screen arrives in pieces -- the ADD/DELETE/CHANGE lines and the
+ * highlight first, then the title and the times -- so it is read only after
+ * the first STATUS packet following the CLEAR, when the panel has finished
+ * drawing it.
+ *
+ * READ ONLY. SELECT is pressed in exactly two kinds of place: on the home and
+ * main menus by goto_pda_menu(), as every PDA programmer thread does, and on
+ * the PROGRAM device list after checking that is the screen showing. Never on
+ * a device's own screen, where every selectable line adds, deletes or changes
+ * a program.
+ */
+
+#define _GNU_SOURCE 1 // for strcasestr
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <ctype.h>
+#include <pthread.h>
+#include <time.h>
+
+#include "aqualink.h"
+#include "utils.h"
+#include "aq_programmer.h"
+#include "aq_serial.h"
+#include "pda.h"
+#include "pda_menu.h"
+#include "pda_programs.h"
+#include "config.h"
+#include "aq_panel.h"
+#include <unistd.h>
+
+// Non-static helpers in pda_aq_programmer.c that its header does not declare.
+void send_pda_cmd(unsigned char cmd);
+void goto_pda_home_first(struct aqualinkdata *aqdata);
+bool goto_pda_menu(struct aqualinkdata *aqdata, pda_menu_type menu);
+bool waitForPDAMessageType(struct aqualinkdata *aqdata, unsigned char mtype, int numMessageReceived);
+bool waitForPDAMessageTypes(struct aqualinkdata *aqdata, unsigned char mtype1, unsigned char mtype2, int numMessageReceived);
+bool waitForPDAMessages(struct aqualinkdata *aqdata, int numberMessages);
+bool waitForPDAnextMenu(struct aqualinkdata *aqdata);
+
+// Copy a panel line with surrounding spaces removed. Never edits the source,
+// which is the live menu buffer the serial thread is writing.
+static void trim_copy(char *dst, const char *src, size_t size)
+{
+  size_t len;
+  while (*src != '\0' && isspace((unsigned char)*src)) src++;
+  len = strnlen(src, AQ_MSGLEN);
+  while (len > 0 && isspace((unsigned char)src[len - 1])) len--;
+  if (len >= size) len = size - 1;
+  memcpy(dst, src, len);
+  dst[len] = '\0';
+}
+
+// "ON      10:00 AM" -> "10:00 AM", when the line starts with the word.
+static bool after_word(char *dst, const char *line, const char *word, size_t size)
+{
+  char t[AQ_MSGLEN + 1];
+  size_t wl = strlen(word);
+  trim_copy(t, line, sizeof(t));
+  if (strncasecmp(t, word, wl) != 0 || (t[wl] != ' ' && t[wl] != '\0'))
+    return false;
+  trim_copy(dst, t + wl, size);
+  return true;
+}
+
+bool pda_parse_program_screen(const char lines[][AQ_MSGLEN + 1], int nlines,
+                              const char *device, panel_program *out)
+{
+  int i, pgm = 0, of = 0;
+  char t[AQ_MSGLEN + 1];
+  bool none = false, have_pgm = false;
+
+  memset(out, 0, sizeof(*out));
+  trim_copy(out->device, device, sizeof(out->device));
+
+  for (i = 0; i < nlines; i++) {
+    trim_copy(t, lines[i], sizeof(t));
+    if (t[0] == '\0')
+      continue;
+    if (strncasecmp(t, "NO PROGRAMS", 11) == 0) {
+      none = true;
+    } else if (sscanf(t, "PGM %d of %d", &pgm, &of) == 2 ||
+               sscanf(t, "PGM %d OF %d", &pgm, &of) == 2) {
+      have_pgm = true;
+    } else if (after_word(out->on, t, "ON", sizeof(out->on))) {
+      ;
+    } else if (after_word(out->off, t, "OFF", sizeof(out->off))) {
+      ;
+    } else if (i >= 2 && i <= 6 && out->days[0] == '\0' &&
+               strcasestr(t, "PROGRAM") == NULL && strcasestr(t, "ENTERED") == NULL) {
+      // The line under the times: ALL DAYS, WEEKDAYS, a list of days.
+      trim_copy(out->days, t, sizeof(out->days));
+    }
+  }
+
+  if (none) {
+    out->pgm = 0;
+    out->of = 0;
+    out->on[0] = out->off[0] = out->days[0] = '\0';
+    return true;
+  }
+  if (!have_pgm || pgm < 1 || of < 1 || pgm > of || of > 99 ||
+      out->on[0] == '\0' || out->off[0] == '\0')
+    return false;   // not a screen this parser recognises; say so rather than guess
+  out->pgm = (unsigned char)pgm;
+  out->of = (unsigned char)of;
+  return true;
+}
+
+// Wait until a device screen has been cleared and fully drawn.
+static bool wait_device_screen(struct aqualinkdata *aqdata)
+{
+  if (!waitForPDAMessageType(aqdata, CMD_PDA_CLEAR, 10))
+    return false;
+  // Lines and the highlight arrive first, the STATUS that ends the frame last.
+  if (!waitForPDAMessageType(aqdata, CMD_STATUS, 30))
+    return false;
+  return pda_m_type() == PM_PROGRAM_DEVICE;
+}
+
+static void fail(struct aqualinkdata *aqdata, const char *why)
+{
+  LOG(PDA_LOG, LOG_ERR, "PDA get programs: %s (menu %d, line '%s')\n",
+      why, pda_m_type(), pda_m_hlight());
+  snprintf(aqdata->panel_programs.error, sizeof(aqdata->panel_programs.error), "%s", why);
+  aqdata->panel_programs.state = PROGRAMS_FAILED;
+}
+
+void *get_PDA_aqualink_programs(void *ptr)
+{
+  struct programmingThreadCtrl *threadCtrl = (struct programmingThreadCtrl *)ptr;
+  struct aqualinkdata *aqdata = threadCtrl->aqdata;
+  static panel_program found[PANEL_PROGRAMS_MAX];
+  char lines[PDA_LINES][AQ_MSGLEN + 1];
+  char first[AQ_MSGLEN + 1] = "";
+  char dev[AQ_MSGLEN + 1];
+  char prev[AQ_MSGLEN + 1] = "";
+  int n = 0, i, l;
+
+  waitForSingleThreadOrTerminate(threadCtrl, AQ_PDA_GET_PROGRAMS);
+
+  aqdata->panel_programs.state = PROGRAMS_READING;
+  aqdata->panel_programs.started_at = time(NULL);
+  aqdata->panel_programs.error[0] = '\0';
+
+  goto_pda_home_first(aqdata);
+  if (!goto_pda_menu(aqdata, PM_PROGRAM)) {
+    fail(aqdata, "could not reach the PROGRAM menu");
+    goto f_end;
+  }
+
+  for (i = 0; i < PANEL_PROGRAMS_MAX; i++) {
+    if (pda_m_type() != PM_PROGRAM || pda_m_hlightindex() < 0) {
+      fail(aqdata, "lost the PROGRAM device list");
+      goto f_home;
+    }
+    trim_copy(dev, pda_m_hlight(), sizeof(dev));
+    if (dev[0] == '\0') {
+      fail(aqdata, "no device highlighted on the PROGRAM list");
+      goto f_home;
+    }
+    if (i == 0) {
+      strcpy(first, dev);
+    } else if (strcmp(dev, first) == 0) {
+      break;   // the ring has come back round: every device has been read
+    }
+
+    // VSP1 SPD PGM is a submenu of pump speeds, not a schedule. Not entered.
+    if (!(strncasecmp(dev, "VSP", 3) == 0 && strcasestr(dev, "SPD") != NULL)) {
+      send_pda_cmd(KEY_PDA_SELECT);
+      if (!wait_device_screen(aqdata)) {
+        fail(aqdata, "a device's program screen did not appear");
+        goto f_home;
+      }
+      for (l = 0; l < PDA_LINES; l++)
+        snprintf(lines[l], sizeof(lines[l]), "%s", pda_m_line(l));
+      if (!pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, dev, &found[n])) {
+        fail(aqdata, "a program screen was not in a recognised form");
+        goto f_home;
+      }
+      LOG(PDA_LOG, LOG_NOTICE, "PDA program '%s' %d of %d on '%s' off '%s' '%s'\n",
+          found[n].device, found[n].pgm, found[n].of, found[n].on, found[n].off, found[n].days);
+      n++;
+
+      send_pda_cmd(KEY_PDA_BACK);
+      if (!waitForPDAnextMenu(aqdata) || pda_m_type() != PM_PROGRAM) {
+        fail(aqdata, "BACK did not return to the PROGRAM list");
+        goto f_home;
+      }
+    }
+
+    // Down one. Mid-list the panel moves the highlight; at the bottom it
+    // shifts the lines and redraws line 9 with the highlight left in place.
+    strcpy(prev, dev);
+    send_pda_cmd(KEY_PDA_DOWN);
+    waitForPDAMessageTypes(aqdata, CMD_PDA_HIGHLIGHT, CMD_MSG_LONG, 10);
+    trim_copy(dev, pda_m_hlight(), sizeof(dev));
+    if (strcmp(dev, prev) == 0) {
+      waitForPDAMessages(aqdata, 6);
+      trim_copy(dev, pda_m_hlight(), sizeof(dev));
+      if (strcmp(dev, prev) == 0) {
+        fail(aqdata, "DOWN did not move along the PROGRAM list");
+        goto f_home;
+      }
+    }
+  }
+
+  if (i >= PANEL_PROGRAMS_MAX) {
+    fail(aqdata, "the PROGRAM list never came back round to its first device");
+    goto f_home;
+  }
+
+  // Publish all at once, so a reader of /api/programs never sees half a walk.
+  memcpy(aqdata->panel_programs.programs, found, sizeof(found[0]) * n);
+  aqdata->panel_programs.count = n;
+  aqdata->panel_programs.read_at = time(NULL);
+  aqdata->panel_programs.state = PROGRAMS_OK;
+  LOG(PDA_LOG, LOG_NOTICE, "PDA read %d program device(s)\n", n);
+
+f_home:
+  goto_pda_menu(aqdata, PM_HOME);
+f_end:
+  cleanAndTerminateThread(threadCtrl);
+  return ptr;
+}
+
+// JSON-safe copy of a panel string. The panel's character set is upper-case
+// ASCII, but nothing here assumes it.
+static int json_str(char *buf, int size, const char *s)
+{
+  int len = 0;
+  if (size < 3) return 0;
+  buf[len++] = '"';
+  for (; *s != '\0' && len < size - 2; s++) {
+    unsigned char c = (unsigned char)*s;
+    if (c == '"' || c == '\\') {
+      if (len >= size - 3) break;
+      buf[len++] = '\\';
+      buf[len++] = (char)c;
+    } else if (c >= 0x20 && c < 0x7f) {
+      buf[len++] = (char)c;
+    }
+  }
+  buf[len++] = '"';
+  buf[len] = '\0';
+  return len;
+}
+
+int build_panel_programs_js(struct aqualinkdata *aqdata, char *buffer, int size)
+{
+  static const char *state_name[] = {"never_read", "reading", "ok", "failed"};
+  panel_programs *pp = &aqdata->panel_programs;
+  int len, i;
+  char q[3 * AQ_MSGLEN + 3];
+
+  if (!isPDA_PANEL) {
+    return snprintf(buffer, size, "{\"type\":\"programs\",\"state\":\"unsupported\","
+                    "\"error\":\"only PDA panels are read\",\"programs\":[]}");
+  }
+
+  json_str(q, sizeof(q), pp->error);
+  len = snprintf(buffer, size,
+                 "{\"type\":\"programs\",\"state\":\"%s\",\"read_at\":%ld,"
+                 "\"started_at\":%ld,\"error\":%s,\"programs\":[",
+                 state_name[pp->state <= PROGRAMS_FAILED ? pp->state : PROGRAMS_FAILED],
+                 (long)pp->read_at, (long)pp->started_at, q);
+
+  for (i = 0; i < pp->count && len < size - 256; i++) {
+    panel_program *p = &pp->programs[i];
+    len += snprintf(buffer + len, size - len, "%s{\"device\":", i ? "," : "");
+    len += json_str(buffer + len, size - len, p->device);
+    len += snprintf(buffer + len, size - len, ",\"pgm\":%d,\"of\":%d,\"on\":", p->pgm, p->of);
+    len += json_str(buffer + len, size - len, p->on);
+    len += snprintf(buffer + len, size - len, ",\"off\":");
+    len += json_str(buffer + len, size - len, p->off);
+    len += snprintf(buffer + len, size - len, ",\"days\":");
+    len += json_str(buffer + len, size - len, p->days);
+    len += snprintf(buffer + len, size - len, "}");
+  }
+  len += snprintf(buffer + len, size - len, "]");
+  if (pp->set.state != PROGRAM_SET_NONE && len < size - 400) {
+    static const char *set_name[] = {"none", "queued", "running", "ok", "failed"};
+    char on[12], off[12];
+    pda_format_clock(pp->set.on_min, on, sizeof(on));
+    pda_format_clock(pp->set.off_min, off, sizeof(off));
+    len += snprintf(buffer + len, size - len, ",\"set\":{\"state\":\"%s\",\"device\":",
+                    set_name[pp->set.state <= PROGRAM_SET_FAILED ? pp->set.state : PROGRAM_SET_FAILED]);
+    len += json_str(buffer + len, size - len, pp->set.device);
+    len += snprintf(buffer + len, size - len, ",\"want_on\":\"%s\",\"want_off\":\"%s\","
+                    "\"requested_at\":%ld,\"done_at\":%ld,\"error\":",
+                    on, off, (long)pp->set.requested_at, (long)pp->set.done_at);
+    len += json_str(buffer + len, size - len, pp->set.error);
+    len += snprintf(buffer + len, size - len, ",\"now_on\":");
+    len += json_str(buffer + len, size - len, pp->set.now.on);
+    len += snprintf(buffer + len, size - len, ",\"now_off\":");
+    len += json_str(buffer + len, size - len, pp->set.now.off);
+    len += snprintf(buffer + len, size - len, "}");
+  }
+  len += snprintf(buffer + len, size - len, "}");
+  return len;
+}
+
+/* ------------------------------------------------------------------ setting
+ *
+ * CHANGE PROGRAM, as captured off this panel (docs/JANDY-PROGRAMS.md, 5):
+ *
+ *   device screen, cursor on CHANGE PROGRAM, Select:
+ *   no CLEAR. Line 1 becomes " CHANGE PROGRAM ", lines 6-9 the instructions,
+ *   and the highlight becomes a character range (HIGHLIGHTCHARS):
+ *
+ *     ON hour      line 3, chars 8-9      Select moves to the next field
+ *     ON minutes   line 3, chars 11-12    one minute per press; line 3 redrawn
+ *     OFF hour     line 4, chars 8-9
+ *     OFF minutes  line 4, chars 11-12
+ *     days         line 5, chars 0-7      Select here SAVES: CLEAR, and the
+ *                                         device screen is redrawn
+ *
+ * NOTHING IS TYPED BLIND. Every press is followed by reading the line the
+ * panel redraws, and the value must have moved by exactly one step in the
+ * direction asked for. Which way Up moves the HOUR has not been seen, so the
+ * first hour press is allowed to reveal the direction once; anything else
+ * unexpected stops the change.
+ *
+ * WHAT A FAILURE LEAVES. No way to leave the editor without saving has been
+ * seen, so a change that goes wrong mid-way puts the field it was on back to
+ * where it started and Selects through the rest UNCHANGED, which saves. Fields
+ * already completed stay changed. The device screen is then read back and
+ * reported as it is: the result always says what the panel holds, never what
+ * was intended.
+ */
+
+int pda_parse_clock(const char *s)
+{
+  int h, m;
+  char ap[3] = "";
+  char t[AQ_MSGLEN + 1];
+  trim_copy(t, s, sizeof(t));
+  if (sscanf(t, "%d:%d %2s", &h, &m, ap) != 3 || h < 1 || h > 12 || m < 0 || m > 59)
+    return -1;
+  if (strcasecmp(ap, "AM") == 0)
+    return (h % 12) * 60 + m;
+  if (strcasecmp(ap, "PM") == 0)
+    return (h % 12 + 12) * 60 + m;
+  return -1;
+}
+
+void pda_format_clock(int minutes, char *out, int size)
+{
+  int h = (minutes / 60) % 24, m = minutes % 60;
+  snprintf(out, size, "%d:%02d %s", h % 12 == 0 ? 12 : h % 12, m, h < 12 ? "AM" : "PM");
+}
+
+static pthread_mutex_t _set_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static int hhmm(const char *s, int n)
+{
+  int i, v = 0;
+  if (n != 4) return -1;
+  for (i = 0; i < 4; i++) {
+    if (s[i] < '0' || s[i] > '9') return -1;
+    v = v * 10 + (s[i] - '0');
+  }
+  if (v / 100 > 23 || v % 100 > 59) return -1;
+  return (v / 100) * 60 + v % 100;
+}
+
+const char *pda_programs_request_set(struct aqualinkdata *aqdata, const char *spec, int len)
+{
+  panel_programs *pp = &aqdata->panel_programs;
+  char dev[AQ_MSGLEN + 1];
+  const char *slash, *dash;
+  int i, on, off, dl;
+  panel_program *have = NULL;
+
+  if (!isPDA_PANEL)
+    return "only PDA panels can be programmed";
+  slash = memchr(spec, '/', len);
+  if (slash == NULL)
+    return "expected programs/set/<DEVICE>/<HHMM>-<HHMM>";
+  dl = (int)(slash - spec);
+  if (dl < 1 || dl > AQ_MSGLEN)
+    return "device name missing or too long";
+  memcpy(dev, spec, dl);
+  dev[dl] = '\0';
+  dash = memchr(slash + 1, '-', len - dl - 1);
+  if (dash == NULL)
+    return "expected <HHMM>-<HHMM>";
+  on = hhmm(slash + 1, (int)(dash - slash - 1));
+  off = hhmm(dash + 1, (int)(spec + len - dash - 1));
+  if (on < 0 || off < 0)
+    return "times are 24-hour HHMM, e.g. 1040-1555";
+  if (on == off)
+    return "ON and OFF are the same time";
+
+  // ONLY WHAT HAS BEEN SEEN. A device the last read did not list, one with
+  // no program (that needs ADD, unmapped) or several (paging, unseen).
+  if (pp->state != PROGRAMS_OK)
+    return "read the programs first (programs/refresh)";
+  for (i = 0; i < pp->count; i++) {
+    if (strcasecmp(pp->programs[i].device, dev) == 0) {
+      have = &pp->programs[i];
+      break;
+    }
+  }
+  if (have == NULL)
+    return "no such device on the panel's PROGRAM list";
+  if (have->of == 0)
+    return "that device has no program; adding one is not supported yet";
+  if (have->of > 1)
+    return "that device has several programs; only a single one can be changed yet";
+
+  pthread_mutex_lock(&_set_lock);
+  if (pp->set.state == PROGRAM_SET_QUEUED || pp->set.state == PROGRAM_SET_RUNNING) {
+    pthread_mutex_unlock(&_set_lock);
+    return "a change is already in progress";
+  }
+  memset(&pp->set, 0, sizeof(pp->set));
+  snprintf(pp->set.device, sizeof(pp->set.device), "%s", have->device);
+  pp->set.on_min = on;
+  pp->set.off_min = off;
+  pp->set.requested_at = time(NULL);
+  pp->set.state = PROGRAM_SET_QUEUED;
+  pthread_mutex_unlock(&_set_lock);
+
+  aq_programmer(AQ_PDA_SET_PROGRAM, NULL, AQP_NULL, AQP_NULL, aqdata);
+  return NULL;
+}
+
+/* ---------------------------------------------------------- waiting, fresh
+ *
+ * NOT waitForPDAMessageType(). It looks at the LAST packet before it waits, so
+ * once one highlight has arrived every later "wait for a highlight" returns at
+ * once -- before the key just pressed has reached the panel. MEASURED, on the
+ * first live change: the Down presses to CHANGE PROGRAM ran ahead of the
+ * screen, the loop saw CHANGE on a stale read and stopped with a third Down
+ * already sent, which wrapped the cursor to ADD, and Select opened the ADD
+ * editor. (It failed safe, and Back there was seen to cancel.)
+ *
+ * So a key is pressed and the queue flushed -- send_cmd() holds one key at a
+ * time and waitfor_pda_queue2empty() returns once it has gone -- and then the
+ * thread waits on packets that arrive AFTER that, until the SCREEN shows the
+ * change asked for. A wait is for a state, never for a packet type.
+ */
+void waitfor_pda_queue2empty();
+
+typedef bool (*screen_test)(const void *ctx);
+
+static bool wait_until(struct aqualinkdata *aqdata, screen_test test, const void *ctx, int max_packets)
+{
+  int i;
+  for (i = 0; i < max_packets; i++) {
+    if (test(ctx))
+      return true;
+    pthread_mutex_lock(&aqdata->active_thread.thread_mutex);
+    pthread_cond_wait(&aqdata->active_thread.thread_cond, &aqdata->active_thread.thread_mutex);
+    pthread_mutex_unlock(&aqdata->active_thread.thread_mutex);
+  }
+  return test(ctx);
+}
+
+static bool never(const void *ctx) { (void)ctx; return false; }
+
+static void press(unsigned char key)
+{
+  send_pda_cmd(key);
+  waitfor_pda_queue2empty();
+}
+
+// Let the panel finish answering whatever was last pressed.
+static void settle(struct aqualinkdata *aqdata)
+{
+  waitfor_pda_queue2empty();
+  wait_until(aqdata, never, NULL, 4);
+}
+
+// The highlighted character range's first column, or -1 when a whole line
+// (or nothing) is highlighted.
+static int hl_start(void)
+{
+  int len = 0, idx = pda_m_hlightindex();
+  char *p = pda_m_hlightchars(&len);
+  if (p == NULL || idx < 0 || len <= 0)
+    return -1;
+  return (int)(p - pda_m_line(idx));
+}
+
+struct hl_was { int idx; char text[AQ_MSGLEN + 1]; };
+static void hl_note(struct hl_was *w)
+{
+  w->idx = pda_m_hlightindex();
+  trim_copy(w->text, pda_m_hlight(), sizeof(w->text));
+}
+// The highlight moved: another line, or (at the bottom of a list that scrolls
+// under it) the same line with different text.
+static bool hl_moved(const void *ctx)
+{
+  const struct hl_was *w = ctx;
+  char now[AQ_MSGLEN + 1];
+  trim_copy(now, pda_m_hlight(), sizeof(now));
+  return pda_m_hlightindex() != w->idx || strcmp(now, w->text) != 0;
+}
+
+struct field_at { int line, col; };
+static bool at_field(const void *ctx)
+{
+  const struct field_at *f = ctx;
+  return pda_m_hlightindex() == f->line && hl_start() == f->col;
+}
+
+// The time on an ON/OFF line, in minutes after midnight, or -1.
+static int line_clock(int line, const char *word)
+{
+  char v[AQ_MSGLEN + 1];
+  if (!after_word(v, pda_m_line(line), word, sizeof(v)))
+    return -1;
+  return pda_parse_clock(v);
+}
+
+struct value_was { int line; const char *word; bool hour; int part; };
+static bool value_moved(const void *ctx)
+{
+  const struct value_was *v = ctx;
+  int now = line_clock(v->line, v->word);
+  return now >= 0 && (v->hour ? now / 60 : now % 60) != v->part;
+}
+
+// A device's program screen, fully drawn: its title, and either its times or
+// NO PROGRAMS. The editor's own screen does not pass (its line 1 is the word
+// CHANGE PROGRAM), nor does the device list.
+static bool device_screen_ready(const void *ctx)
+{
+  (void)ctx;
+  if (pda_m_type() != PM_PROGRAM_DEVICE || pda_m_line(0)[0] == '\0')
+    return false;
+  if (strcasestr(pda_m_line(4), "NO PROGRAMS") != NULL)
+    return true;
+  return strcasestr(pda_m_line(1), "PGM") != NULL
+      && line_clock(3, "ON") >= 0 && line_clock(4, "OFF") >= 0;
+}
+
+static bool wait_device_screen_fresh(struct aqualinkdata *aqdata)
+{
+  if (!wait_until(aqdata, device_screen_ready, NULL, 60))
+    return false;
+  settle(aqdata);
+  return device_screen_ready(NULL);
+}
+
+/* Step one field to `target` (minutes after midnight; only its hour or only
+ * its minute part is compared, by `hour`). One press at a time, each waited
+ * for on the screen. False on anything but exactly one step per press, with
+ * *moved = net Up presses applied, so the caller can undo them. */
+static bool step_field(struct aqualinkdata *aqdata, int line, const char *word,
+                       bool hour, int target, int *moved)
+{
+  bool up_is_plus = true, learned = !hour, key_up;   // minutes: Down was seen to go down
+  int presses, cur, want, dir, got, delta, mod = hour ? 24 : 60;
+  struct value_was was;
+
+  *moved = 0;
+  for (presses = 0; presses < 40; presses++) {
+    cur = line_clock(line, word);
+    if (cur < 0) return false;
+    cur = hour ? cur / 60 : cur % 60;
+    want = hour ? (target / 60) % 24 : target % 60;
+    if (cur == want) return true;
+    // Shortest way round for the hour; never wrap the minutes (the hour
+    // would not follow, and a minute field that carried would be unseen).
+    if (hour) dir = (((want - cur) % 24) + 24) % 24 <= 12 ? +1 : -1;
+    else dir = want > cur ? +1 : -1;
+
+    key_up = (dir > 0) == up_is_plus;
+    was.line = line; was.word = word; was.hour = hour; was.part = cur;
+    press(key_up ? KEY_PDA_UP : KEY_PDA_DOWN);
+    *moved += key_up ? 1 : -1;
+    if (!wait_until(aqdata, value_moved, &was, 30))
+      return false;                          // the press changed nothing on screen
+    got = line_clock(line, word);
+    got = hour ? got / 60 : got % 60;
+    delta = (((got - cur) % mod) + mod) % mod;
+    if (delta == 1) delta = +1;
+    else if (delta == mod - 1) delta = -1;
+    else return false;                       // more than one step
+    if (delta != dir) {
+      if (learned) return false;             // the wrong way, and not for the first time
+      up_is_plus = !up_is_plus;              // the hour's Up runs the other way
+    }
+    learned = true;
+  }
+  return false;
+}
+
+// Leave the editor the only way seen to keep the program: Select through the
+// remaining fields, unchanged, until the device screen is redrawn.
+static bool save_out_of_editor(struct aqualinkdata *aqdata)
+{
+  int i;
+  for (i = 0; i < 6; i++) {
+    press(KEY_PDA_SELECT);
+    if (wait_until(aqdata, device_screen_ready, NULL, 40)) {
+      settle(aqdata);
+      return true;
+    }
+  }
+  return false;
+}
+
+// Press the opposite key `moved` times (net Up presses), each waited for.
+static void undo_presses(struct aqualinkdata *aqdata, int line, const char *word, bool hour, int moved)
+{
+  int i, cur;
+  struct value_was was;
+  for (i = 0; i < abs(moved) && i < 40; i++) {
+    cur = line_clock(line, word);
+    was.line = line; was.word = word; was.hour = hour;
+    was.part = cur < 0 ? -1 : (hour ? cur / 60 : cur % 60);
+    press(moved > 0 ? KEY_PDA_DOWN : KEY_PDA_UP);
+    wait_until(aqdata, value_moved, &was, 30);
+  }
+}
+
+static void set_fail(struct aqualinkdata *aqdata, const char *why)
+{
+  LOG(PDA_LOG, LOG_ERR, "PDA set program: %s (menu %d, line '%s')\n",
+      why, pda_m_type(), pda_m_hlight());
+  snprintf(aqdata->panel_programs.set.error, sizeof(aqdata->panel_programs.set.error), "%s", why);
+  aqdata->panel_programs.set.state = PROGRAM_SET_FAILED;
+  aqdata->panel_programs.set.done_at = time(NULL);
+}
+
+static bool is_change_editor(void)
+{
+  return strcasestr(pda_m_line(1), "CHANGE PROGRAM") != NULL;
+}
+// An editor screen of some kind: the instructions are on lines 6-9.
+static bool is_an_editor(void)
+{
+  return strcasestr(pda_m_line(6), "ARROW") != NULL;
+}
+
+void *set_PDA_aqualink_program(void *ptr)
+{
+  struct programmingThreadCtrl *threadCtrl = (struct programmingThreadCtrl *)ptr;
+  struct aqualinkdata *aqdata = threadCtrl->aqdata;
+  panel_program_set *req = &aqdata->panel_programs.set;
+  panel_program before, after;
+  char lines[PDA_LINES][AQ_MSGLEN + 1];
+  char dev[AQ_MSGLEN + 1], first[AQ_MSGLEN + 1] = "";
+  bool in_editor = false, ok = true;
+  int i, l, moved = 0, field;
+  struct hl_was hw;
+  struct field_at fa;
+  static const struct { int line, col; const char *word; bool hour; } F[] = {
+    {3, 8, "ON", true}, {3, 11, "ON", false}, {4, 8, "OFF", true}, {4, 11, "OFF", false}};
+
+  waitForSingleThreadOrTerminate(threadCtrl, AQ_PDA_SET_PROGRAM);
+  req->state = PROGRAM_SET_RUNNING;
+
+  goto_pda_home_first(aqdata);
+  if (!goto_pda_menu(aqdata, PM_PROGRAM)) {
+    set_fail(aqdata, "could not reach the PROGRAM menu");
+    goto f_end;
+  }
+  settle(aqdata);
+
+  // Down the ring to the device, each press waited for on the screen.
+  for (i = 0; i < PANEL_PROGRAMS_MAX; i++) {
+    if (pda_m_type() != PM_PROGRAM) { set_fail(aqdata, "lost the PROGRAM device list"); goto f_home; }
+    trim_copy(dev, pda_m_hlight(), sizeof(dev));
+    if (strcasecmp(dev, req->device) == 0) break;
+    if (i == 0) strcpy(first, dev);
+    else if (strcmp(dev, first) == 0) { set_fail(aqdata, "the device is no longer on the PROGRAM list"); goto f_home; }
+    hl_note(&hw);
+    press(KEY_PDA_DOWN);
+    if (!wait_until(aqdata, hl_moved, &hw, 30)) { set_fail(aqdata, "DOWN did not move along the PROGRAM list"); goto f_home; }
+  }
+  if (i >= PANEL_PROGRAMS_MAX) { set_fail(aqdata, "never reached the device"); goto f_home; }
+  settle(aqdata);
+  trim_copy(dev, pda_m_hlight(), sizeof(dev));
+  if (pda_m_type() != PM_PROGRAM || strcasecmp(dev, req->device) != 0) {
+    set_fail(aqdata, "the cursor was not on the device when it came to Select");
+    goto f_home;
+  }
+
+  press(KEY_PDA_SELECT);
+  if (!wait_device_screen_fresh(aqdata)) { set_fail(aqdata, "the device's program screen did not appear"); goto f_home; }
+  for (l = 0; l < PDA_LINES; l++) snprintf(lines[l], sizeof(lines[l]), "%s", pda_m_line(l));
+  if (!pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, req->device, &before)
+      || before.of != 1) {
+    set_fail(aqdata, "the device does not show exactly one program");
+    goto f_back;
+  }
+  if (pda_parse_clock(before.on) == req->on_min && pda_parse_clock(before.off) == req->off_min) {
+    after = before;            // already so: nothing to press
+    goto f_done;
+  }
+
+  // To CHANGE PROGRAM: two lines under ADD, where the cursor starts. Each
+  // Down is waited for on the screen, and the cursor is read again after the
+  // panel has settled -- the check that was stale on the first live run.
+  for (i = 0; i < 3 && strncasecmp(pda_m_hlight(), "CHANGE", 6) != 0; i++) {
+    hl_note(&hw);
+    press(KEY_PDA_DOWN);
+    if (!wait_until(aqdata, hl_moved, &hw, 30)) { set_fail(aqdata, "DOWN did not move on the device's screen"); goto f_back; }
+  }
+  settle(aqdata);
+  if (strncasecmp(pda_m_hlight(), "CHANGE", 6) != 0) { set_fail(aqdata, "could not reach CHANGE PROGRAM"); goto f_back; }
+
+  press(KEY_PDA_SELECT);
+  fa.line = F[0].line; fa.col = F[0].col;
+  if (!wait_until(aqdata, at_field, &fa, 40) || !is_change_editor()) {
+    set_fail(aqdata, "the program editor did not open on the ON hour");
+    if (is_change_editor()) {
+      in_editor = !save_out_of_editor(aqdata);   // it did open, oddly: leave it unchanged
+      goto f_home;
+    }
+    if (is_an_editor()) {
+      // Some other editor -- ADD, the one the first live run reached. Back
+      // was seen to cancel ADD without adding anything.
+      press(KEY_PDA_BACK);
+      wait_until(aqdata, device_screen_ready, NULL, 40);
+    }
+    goto f_back;
+  }
+  in_editor = true;
+
+  for (field = 0; field < 4; field++) {
+    int target = F[field].line == 3 ? req->on_min : req->off_min;
+    if (ok && !step_field(aqdata, F[field].line, F[field].word, F[field].hour, target, &moved)) {
+      // Put this field back, and change nothing more: see WHAT A FAILURE LEAVES.
+      undo_presses(aqdata, F[field].line, F[field].word, F[field].hour, moved);
+      set_fail(aqdata, "a value did not move one step per press; the rest was left unchanged");
+      ok = false;
+    }
+    settle(aqdata);
+    press(KEY_PDA_SELECT);
+    fa.line = field < 3 ? F[field + 1].line : 5;
+    fa.col = field < 3 ? F[field + 1].col : 0;
+    if (!wait_until(aqdata, at_field, &fa, 40)) {
+      if (ok) set_fail(aqdata, "the editor did not move to the next field");
+      ok = false;
+      break;
+    }
+  }
+  // On the days field: unchanged. Select saves. After a failure, Select on
+  // through whatever is left, which also saves.
+  settle(aqdata);
+  in_editor = false;
+  if (!(ok ? (press(KEY_PDA_SELECT), wait_device_screen_fresh(aqdata)) : save_out_of_editor(aqdata))) {
+    if (ok) set_fail(aqdata, "the device's screen did not return after saving");
+    in_editor = true;
+    goto f_home;
+  }
+  for (l = 0; l < PDA_LINES; l++) snprintf(lines[l], sizeof(lines[l]), "%s", pda_m_line(l));
+  if (!pda_parse_program_screen((const char (*)[AQ_MSGLEN + 1])lines, PDA_LINES, req->device, &after)) {
+    set_fail(aqdata, "could not read the program back after saving");
+    goto f_back;
+  }
+
+f_done:
+  req->now = after;
+  // The cached read gets the panel's own answer for this device.
+  for (i = 0; i < aqdata->panel_programs.count; i++)
+    if (strcasecmp(aqdata->panel_programs.programs[i].device, req->device) == 0)
+      aqdata->panel_programs.programs[i] = after;
+  if (ok) {
+    if (pda_parse_clock(after.on) == req->on_min && pda_parse_clock(after.off) == req->off_min) {
+      req->state = PROGRAM_SET_OK;
+      req->done_at = time(NULL);
+      LOG(PDA_LOG, LOG_NOTICE, "PDA set program '%s' now on '%s' off '%s'\n", after.device, after.on, after.off);
+    } else {
+      set_fail(aqdata, "saved, but the panel shows different times");
+    }
+  }
+
+f_back:
+  press(KEY_PDA_BACK);
+  waitForPDAnextMenu(aqdata);
+f_home:
+  if (in_editor)   // still inside it: do NOT navigate; the panel times out to home
+    LOG(PDA_LOG, LOG_ERR, "PDA set program: could not leave the editor; leaving the panel to time out\n");
+  else
+    goto_pda_menu(aqdata, PM_HOME);
+f_end:
+  if (req->state == PROGRAM_SET_RUNNING || req->state == PROGRAM_SET_QUEUED)
+    set_fail(aqdata, "stopped without a result");
+  cleanAndTerminateThread(threadCtrl);
+  return ptr;
+}
diff --git a/source/pda_programs.h b/source/pda_programs.h
new file mode 100644
index 0000000..20a0319
--- /dev/null
+++ b/source/pda_programs.h
@@ -0,0 +1,83 @@
+/*
+ * Read the panel's own equipment programs (on/off times) through the PDA
+ * PROGRAM menu, and serve them as JSON.
+ *
+ * READ ONLY. The thread walks MENU > PROGRAM > each device, reads the screen
+ * and presses BACK. It never presses SELECT on a device's program screen,
+ * where every line is an ADD / DELETE / CHANGE action.
+ */
+#ifndef PDA_PROGRAMS_H_
+#define PDA_PROGRAMS_H_
+
+#include <stdbool.h>
+#include <time.h>
+
+#include "aq_serial.h"   // AQ_MSGLEN
+
+#define PANEL_PROGRAMS_MAX 24   // devices on the PROGRAM list; this panel has 11
+
+typedef enum {
+  PROGRAMS_NEVER_READ = 0,
+  PROGRAMS_READING,
+  PROGRAMS_OK,
+  PROGRAMS_FAILED
+} panel_programs_state;
+
+typedef struct panel_program {
+  char device[AQ_MSGLEN + 1];
+  unsigned char pgm;     // which program is shown, 1-based
+  unsigned char of;      // how many the panel says the device has; 0 = none entered
+  char on[AQ_MSGLEN + 1];
+  char off[AQ_MSGLEN + 1];
+  char days[AQ_MSGLEN + 1];
+} panel_program;
+
+typedef enum {
+  PROGRAM_SET_NONE = 0,
+  PROGRAM_SET_QUEUED,
+  PROGRAM_SET_RUNNING,
+  PROGRAM_SET_OK,
+  PROGRAM_SET_FAILED
+} panel_program_set_state;
+
+// One change to one device's ON/OFF times, and what became of it. Only the
+// last request is kept: the caller reads the result back from /api/programs.
+typedef struct panel_program_set {
+  panel_program_set_state state;
+  char device[AQ_MSGLEN + 1];
+  int on_min, off_min;   // wanted, minutes after midnight
+  time_t requested_at, done_at;
+  char error[96];
+  panel_program now;     // what the panel showed after the save, read back
+} panel_program_set;
+
+typedef struct panel_programs {
+  panel_programs_state state;
+  time_t read_at;        // when the last COMPLETE read finished
+  time_t started_at;     // when the current or last read began
+  char error[64];        // why the last read failed, empty otherwise
+  int count;
+  panel_program programs[PANEL_PROGRAMS_MAX];
+  panel_program_set set;
+} panel_programs;
+
+struct aqualinkdata;
+
+void *get_PDA_aqualink_programs(void *ptr);
+void *set_PDA_aqualink_program(void *ptr);
+
+// Validate and queue a change. NULL when queued; otherwise why it was refused.
+// `spec` is "<DEVICE>/<HHMM>-<HHMM>" in 24-hour time, e.g. "SOLAR HEAT/1040-1555".
+const char *pda_programs_request_set(struct aqualinkdata *aqdata, const char *spec, int len);
+
+// "10:05 AM" -> 605; -1 if it is not a panel time. Exposed for the harness.
+int pda_parse_clock(const char *s);
+void pda_format_clock(int minutes, char *out, int size);
+
+// Parse one fully drawn device screen. Exposed for the test harness.
+bool pda_parse_program_screen(const char lines[][AQ_MSGLEN + 1], int nlines,
+                              const char *device, panel_program *out);
+
+int build_panel_programs_js(struct aqualinkdata *aqdata, char *buffer, int size);
+
+#endif
