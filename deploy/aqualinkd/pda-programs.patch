diff --git a/source/aq_scheduler.c b/source/aq_scheduler.c
index 6956d53..9ea0a99 100644
--- a/source/aq_scheduler.c
+++ b/source/aq_scheduler.c
@@ -41,6 +41,48 @@ Example /etc/cron.d/aqualinkd
 
 
 
+/*
+ * poolhound: every field of a schedule ends up in a line cron runs AS ROOT
+ * (`root curl ... <url> -d value=<value>`), and each was copied into a fixed
+ * buffer with no length check. So a field is copied only if it fits, and a
+ * line is written only if every field is in the shape AqualinkD itself writes:
+ * cron fields of digits and * , / -, a url /api/<id>/set of letters, digits,
+ * _ and /, and a numeric value. Anything else refuses the whole save before
+ * the file is opened, so a bad entry neither runs nor truncates the list.
+ */
+static bool sc_copy(char *dst, size_t size, const char *src, int len)
+{
+  if (len < 0 || (size_t)len >= size)
+    return false;
+  memcpy(dst, src, len);
+  dst[len] = '\0';
+  return true;
+}
+
+static bool sc_only(const char *v, const char *allowed, size_t maxlen)
+{
+  size_t n = strlen(v);
+  if (n == 0 || n > maxlen)
+    return false;
+  for (size_t i = 0; i < n; i++)
+    if (strchr(allowed, v[i]) == NULL)
+      return false;
+  return true;
+}
+
+static bool sc_valid(const aqs_cron *c)
+{
+  const char *cronchars = "0123456789*,/-";
+  const char *urlchars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_/";
+  size_t ul = strlen(c->url);
+  return sc_only(c->minute, cronchars, CV_SIZE - 1) && sc_only(c->hour, cronchars, CV_SIZE - 1)
+      && sc_only(c->daym, cronchars, CV_SIZE - 1) && sc_only(c->month, cronchars, CV_SIZE - 1)
+      && sc_only(c->dayw, cronchars, CV_SIZE - 1)
+      && sc_only(c->url, urlchars, CV_SIZE * 2 - 1) && ul > 9
+      && strncmp(c->url, "/api/", 5) == 0 && strcmp(c->url + ul - 4, "/set") == 0
+      && sc_only(c->value, "0123456789", 8);
+}
+
 bool passJson_scObj(const char* line, int length, aqs_cron *values)
 {
   int keystart=0;
@@ -72,32 +114,25 @@ bool passJson_scObj(const char* line, int length, aqs_cron *values)
