# Copy to deploy/.env (gitignored) and fill in. Used by compose.yml, and by
# bootstrap-server.sh for the author's own Azure deployment.
#
# None of these are secrets — using the Azure ones still requires an Azure
# identity — but together they are a map of the deployment, and a public
# repository is no place for one.

# ---------------------------------------------------------- everybody needs
# The address(es) this answers on, comma-separated as a Caddy site block wants
# them. Caddy asks Let's Encrypt for a certificate for each, so they must
# resolve to this host. poolhound also refuses any request whose Host is not
# one of these, which is what stops DNS rebinding.
PUBLIC_HOSTS="poolhound.example.com, pool.example.com"

# Let's Encrypt wants a contact address for expiry warnings.
ACME_EMAIL=you@example.com

TZ=UTC

# How somebody signs in: `password` (Caddy checks a hash) or `forward`
# (oauth2-proxy). Leave it alone unless you already run an identity provider.
AUTH_MODE=password

# WHO may sign in is NOT here — it is deploy/caddy/users.caddy, because a
# bcrypt hash contains three `$` and compose would interpolate them away:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'secret' \
#     | sed "s|^|owner |" > deploy/caddy/users.caddy

# Only for AUTH_MODE=forward: where an unauthenticated browser is sent to sign
# in, usually a vhost of its own shared by several services.
OAUTH2_HOST=auth.example.com

# ---------------------------------------------- what this host is CALLED here
# A LOGICAL NAME, used wherever the documentation and the scripts need to refer
# to the machine. `webhost` is the name this repository uses for it; the real
# one goes in your own untracked copy of this file and reaches no tracked file.
#
# WHY THIS KEY EXISTS AT ALL. The host's short name had leaked into three
# tracked files — a paragraph in CLAUDE.md, a comment in bootstrap-server.sh
# and an environment variable in poolhound/agent.py — while bin/selftest said
# "no tracked file names the host this is deployed on" and went green. The
# scanner only ever matched DOTTED hostnames, so a bare word was invisible to
# it. Naming the fact here is what lets the check compare the tree against it.
SERVER_NAME=webhost

# The Compose PROJECT name on that host, which is the prefix on every container
# (`<project>-poolhound-1`, `<project>-caddy-1`). bootstrap-server.sh builds
# the container names from this rather than spelling them out, because it used
# to spell them out thirteen times and the project name is the stack directory
# by another route — the one other fact CLAUDE.md says no tracked file may
# carry.
COMPOSE_PROJECT=webhost

# ------------------------------------- only the Azure deployment needs these
# bootstrap-server.sh reads them; compose.yml does not. Delete them if you are
# running the standalone stack, which needs no cloud account.
RG=my-resource-group
VM=my-vm
SERVER_IP=203.0.113.10
STACK=/home/azureuser/stack
STORAGE=mystorageaccount
SHARE=poolhound
VAULT=my-key-vault
